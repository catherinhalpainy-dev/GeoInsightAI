{
  "version": 8,
  "name": "GeoInsight Dark GIS",
  "metadata": {
    "maputnik:renderer": "mlgljs",
    "openmaptiles:version": "3.x",
    "geoinsight:theme": "dark-low-saturation-gis-workbench",
    "geoinsight:design-principle": "data-first-dark",
    "geoinsight:source-note": "OpenFreeMap public OpenMapTiles endpoint; no API key required. Attribution required by data/provider terms.",
    "geoinsight:palette-note": "Low-saturation dark GIS basemap designed to preserve contrast for parcel, selection, risk, heatmap and analytical overlays."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
